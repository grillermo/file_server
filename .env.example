AUTH_TOKEN=replace-with-a-long-random-token
# Links in upload responses; set it so LAN uploads return the public URL.
PUBLIC_URL=https://files.chiq.me
# Signs the browser login cookie for the publish toggle on /index.
# Generate: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
SESSION_SECRET=replace-with-64-hex-chars
# Base of the demo links shown on /index.
DEMOS_URL=https://files.grillermo.com
# Port of the demos process (files.grillermo.com tunnel route points here).
DEMO_PORT=33334
# Where published copies live. The main app and the demos process must resolve to
# the same directory (default: ./demos next to app.rb), and it must differ from FILES_DIR.
# DEMOS_DIR=/absolute/path/to/demos
