#!/usr/bin/env bash
# (Re)start both file_server panes in tmux session "file_server", in place, and
# return. Run by ../server/after-reboot.sh at boot and by ./activate after
# git-sync lands new code.
#
#   files : the full app (files.chiq.me + LAN) on $PORT (default 33333)
#   demos : demos.ru, only the published copies in demos/, on $DEMO_PORT
#           (default 33334). Bound to 127.0.0.1: the only way in is the
#           files.grillermo.com tunnel route (cloudflared runs on this host).
set -euo pipefail

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$APP_DIR"

set -a
# shellcheck source=/dev/null
[ -f .env ] && . ./.env
set +a

SESSION='file_server'
FILES_PORT="${PORT:-33333}"
DEMOS_PORT="${DEMO_PORT:-33334}"
export RACK_ENV="${RACK_ENV:-deployment}"
# shellcheck source=/dev/null
. "$HOME/c/server/serve-in-place.sh"

# tmux panes do not inherit this script's environment when a tmux server is
# already running, so each pane command re-sources .env itself.
pane_cmd() {
  echo "sh -c 'set -a; [ ! -f .env ] || . ./.env; set +a; exec env RACK_ENV=$RACK_ENV bundle exec rackup $1'"
}

# demos.ru has no health endpoint on purpose: any answer below 500 means up.
serve_pane demos "$DEMOS_PORT" "$(pane_cmd "demos.ru -o 127.0.0.1 -p $DEMOS_PORT -s webrick")" /
# Files last: both panes register under this session name with top_cpu, and the
# last wrapper to start is the entry it keeps, so that should be the main app.
serve_pane files "$FILES_PORT" "$(pane_cmd "config.ru -p $FILES_PORT -s webrick")" /health

echo "==> Session '$SESSION': files:$FILES_PORT, demos:$DEMOS_PORT"
serve_attach
